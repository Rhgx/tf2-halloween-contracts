{
  "name": "tf2-halloween-utils",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "TF2 Halloween tools: a contracts checklist that syncs from Steam and writes your casual queue, and a soul gargoyle radar overlay.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc",
    "format": "prettier --write .",
